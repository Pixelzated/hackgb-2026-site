// Cloudflare Workers: serve the prerendered site in build/ as static assets. No Worker script needed.
{
  "name": "rehome",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page"
  },
  // rehome.casa's DNS is on Cloudflare, so Workers attaches the domain (and its certificate) on deploy
  "routes": [{ "pattern": "rehome.casa", "custom_domain": true }]
}
